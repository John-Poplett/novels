# Sample configuration. Copy to .env and adjust:
#
#     cp .env.example .env
#
# .env is git-ignored; only this sample is versioned.

# Where the "golden" source corpus archive (7z, ~71 MB) lives. This may
# move -- e.g. from Backblaze to HuggingFace -- without any code change.
# What guarantees the bytes are the ones the published results came from is
# the SHA-256 pinned as `archive_sha256` in _targets.R, which is checked
# before extraction. targets does not hash environment variables, so the
# digest must stay in code, not here.
NOVELS_ARCHIVE_URL=https://f005.backblazeb2.com/file/public-johnpoplett-09477/novels.7z
